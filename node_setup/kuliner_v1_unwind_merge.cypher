  {nama: "Udang Selingkuh", tingkat_pedas: 1, rasa: "gurih", metode_masak: "rebus", vegetarian: null, suhu_sajian: null},
  {nama: "Sate Rusa", tingkat_pedas: 1, rasa: "gurih", metode_masak: "bakar", vegetarian: null, suhu_sajian: null},
  {nama: "Labu Ikan Kuah Kuning", tingkat_pedas: 1, rasa: "asam gurih", metode_masak: "rebus", vegetarian: null, suhu_sajian: null}
] AS r
MATCH (h:Hidangan {nama: r.nama})
SET h.tingkat_pedas = r.tingkat_pedas,
    h.rasa          = r.rasa,
    h.metode_masak  = r.metode_masak,
    h.vegetarian    = r.vegetarian,
    h.suhu_sajian   = r.suhu_sajian;

