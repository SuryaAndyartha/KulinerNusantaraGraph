  {nama: "Garam", kelas: "Bumbu", alergen: []},
  {nama: "Terasi", kelas: "Bumbu Fermentasi", alergen: ["Krustasea"]},
  {nama: "Petis", kelas: "Bumbu Fermentasi", alergen: ["Krustasea"]},
