] AS r
MATCH (k:KelasBahan {nama: r.kelas})
MERGE (b:Bahan {nama: r.nama})
MERGE (b)-[:INSTANCE_OF]->(k)
WITH b, r
UNWIND r.alergen AS namaAlergen          
MATCH (al:Alergen {nama: namaAlergen})
MERGE (b)-[:MEMICU_ALERGI]->(al);

