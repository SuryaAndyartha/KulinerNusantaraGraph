// =====================================================================
//  KULINER NUSANTARA KNOWLEDGE GRAPH - VERSION 1 (UNWIND + MERGE)
// =====================================================================

// ---------- 0. Empty database ---------- Or if possible, create a new database (not available in community version of Neo4j)
MATCH (n) DETACH DELETE n;

// ---------- 1. Constraint: Assign unique constraint for each component's name ----------
CREATE CONSTRAINT kelas_hidangan_nama IF NOT EXISTS FOR (n:KelasHidangan) REQUIRE n.nama IS UNIQUE;
CREATE CONSTRAINT kelas_bahan_nama IF NOT EXISTS FOR (n:KelasBahan) REQUIRE n.nama IS UNIQUE;
CREATE CONSTRAINT hidangan_nama IF NOT EXISTS FOR (n:Hidangan) REQUIRE n.nama IS UNIQUE;
CREATE CONSTRAINT bahan_nama IF NOT EXISTS FOR (n:Bahan) REQUIRE n.nama IS UNIQUE;
CREATE CONSTRAINT alergen_nama IF NOT EXISTS FOR (n:Alergen) REQUIRE n.nama IS UNIQUE;
CREATE CONSTRAINT daerah_nama IF NOT EXISTS FOR (n:Daerah) REQUIRE n.nama IS UNIQUE;

// =============
// Node Creation
// =============

// ---------- 2. Class hidangan: [child, parent] ---------- Using UNWIND as an alternative for manual CREATE
UNWIND [
  ["Makanan", "Kuliner"],
  ["Minuman", "Kuliner"],
  ["Hidangan Utama", "Makanan"],
  ["Jajanan", "Makanan"],
  ["Pelengkap", "Makanan"],
  ["Minuman Tradisional", "Minuman"],
  ["Hidangan Berkuah", "Hidangan Utama"],
  ["Hidangan Nasi", "Hidangan Utama"],
  ["Bubur", "Hidangan Utama"],
  ["Olahan Daging", "Hidangan Utama"],
  ["Olahan Ikan", "Hidangan Utama"],
  ["Olahan Sagu", "Hidangan Utama"],
  ["Olahan Umbi", "Hidangan Utama"],
  ["Hidangan Mi", "Hidangan Utama"],
  ["Hidangan Sayur", "Hidangan Utama"],
  ["Soto", "Hidangan Berkuah"],
  ["Gulai", "Hidangan Berkuah"],
  ["Sup", "Hidangan Berkuah"],
  ["Sate", "Olahan Daging"],
  ["Masakan Bumbu", "Olahan Daging"],
  ["Kue Tradisional", "Jajanan"],
  ["Gorengan", "Jajanan"],
  ["Sambal", "Pelengkap"],
  ["Es Tradisional", "Minuman Tradisional"],
  ["Wedang", "Minuman Tradisional"],
  ["Kopi dan Teh Tradisional", "Minuman Tradisional"]
] AS pasangan
MERGE (anak:KelasHidangan  {nama: pasangan[0]})
MERGE (induk:KelasHidangan {nama: pasangan[1]})
MERGE (anak)-[:IS_A]->(induk);

// ---------- 3. Class bahan: [child, parent] ---------- Using UNWIND as an alternative for manual CREATE
UNWIND [
  ["Bahan Hewani", "Bahan"],
  ["Bahan Nabati", "Bahan"],
  ["Bumbu", "Bahan"],
  ["Daging", "Bahan Hewani"],
  ["Unggas", "Bahan Hewani"],
  ["Ikan", "Bahan Hewani"],
  ["Seafood", "Bahan Hewani"],
  ["Telur dan Susu", "Bahan Hewani"],
  ["Biji-bijian dan Umbi", "Bahan Nabati"],
  ["Kacang-kacangan", "Bahan Nabati"],
  ["Sayuran", "Bahan Nabati"],
  ["Kelapa dan Olahannya", "Bahan Nabati"],
  ["Buah", "Bahan Nabati"],
  ["Kopi dan Teh", "Bahan Nabati"],
  ["Rempah", "Bumbu"],
  ["Bumbu Fermentasi", "Bumbu"],
  ["Pemanis", "Bumbu"]
] AS pasangan
MERGE (anak:KelasBahan  {nama: pasangan[0]})
MERGE (induk:KelasBahan {nama: pasangan[1]})
MERGE (anak)-[:IS_A]->(induk);

// ---------- 4. Default value for several class (attribute, for exception purposes) ----------
MATCH (k:KelasHidangan {nama: "Hidangan Sayur"}) SET k.vegetarian = true;
MATCH (k:KelasHidangan {nama: "Sambal"}) SET k.vegetarian = true;
MATCH (k:KelasHidangan {nama: "Kue Tradisional"}) SET k.rasa = "manis";
MATCH (k:KelasHidangan {nama: "Minuman Tradisional"}) SET k.suhu_sajian = "dingin";
MATCH (k:KelasHidangan {nama: "Wedang"}) SET k.suhu_sajian = "panas";
MATCH (k:KelasHidangan {nama: "Kopi dan Teh Tradisional"}) SET k.suhu_sajian = "panas";

// ---------- 5. Alergen ----------
UNWIND [
  {nama: "Kacang Tanah", keterangan: "Kacang tanah dan olahannya"},
  {nama: "Kedelai", keterangan: "Kedelai dan olahannya (tempe, tahu)"},
  {nama: "Gluten", keterangan: "Gandum / tepung terigu"},
  {nama: "Ikan", keterangan: "Ikan bersirip"},
  {nama: "Krustasea", keterangan: "Udang, kepiting, terasi, petis"},
  {nama: "Telur", keterangan: "Telur unggas"},
  {nama: "Susu", keterangan: "Susu dan produk susu"},
  {nama: "Moluska", keterangan: "Siput, kerang, cumi"},
  {nama: "Kacang Pohon", keterangan: "Kenari, kacang mete, almon"}
] AS a
MERGE (al:Alergen {nama: a.nama})
SET al.keterangan = a.keterangan;

// =====================
// Relationship Creation
// =====================

// ---------- 6. Daerah: Provinsi -PART_OF-> Wilayah -PART_OF-> Negara ----------
MERGE (:Daerah:Negara {nama: 'Indonesia'});

UNWIND [
  {wilayah: "Wilayah Sumatera", provinsi: ["Aceh", "Sumatera Utara", "Sumatera Barat", "Riau", "Kepulauan Riau", "Jambi", "Sumatera Selatan", "Bengkulu", "Lampung", "Kepulauan Bangka Belitung"]},
  {wilayah: "Wilayah Jawa", provinsi: ["DKI Jakarta", "Banten", "Jawa Barat", "Jawa Tengah", "DI Yogyakarta", "Jawa Timur"]},
  {wilayah: "Wilayah Bali dan Nusa Tenggara", provinsi: ["Bali", "Nusa Tenggara Barat", "Nusa Tenggara Timur"]},
  {wilayah: "Wilayah Kalimantan", provinsi: ["Kalimantan Barat", "Kalimantan Tengah", "Kalimantan Selatan", "Kalimantan Timur", "Kalimantan Utara"]},
  {wilayah: "Wilayah Sulawesi", provinsi: ["Sulawesi Utara", "Gorontalo", "Sulawesi Tengah", "Sulawesi Barat", "Sulawesi Selatan", "Sulawesi Tenggara"]},
  {wilayah: "Wilayah Maluku", provinsi: ["Maluku", "Maluku Utara"]},
  {wilayah: "Wilayah Papua", provinsi: ["Papua", "Papua Barat", "Papua Barat Daya", "Papua Tengah", "Papua Pegunungan", "Papua Selatan"]}
] AS baris
MATCH (negara:Negara {nama: 'Indonesia'})
MERGE (wil:Daerah:Wilayah {nama: baris.wilayah})
MERGE (wil)-[:PART_OF]->(negara)
WITH wil, baris
UNWIND baris.provinsi AS namaProvinsi
MERGE (prov:Daerah:Provinsi {nama: namaProvinsi})
MERGE (prov)-[:PART_OF]->(wil);

